{
  "recognition_correction": {
    "rules": [
      "Show correction after submission.",
      "Do not show Recognition score.",
      "Do not show Accuracy score.",
      "Do not show Distinction answer.",
      "Do not show Application answer."
    ],
    "if_incorrect_answers_greater_than_5": {
      "first": "Compact Error Summary Table",
      "then": "Grouped Structural Explanations"
    },
    "compact_table": {
      "columns": ["Question", "Your Answer", "Correct Answer", "Correct Word"]
    },
    "grouped_explanation": {
      "group_by": "Common Misconception / Misused Word Pattern",
      "include": [
        "misconception",
        "affected_questions",
        "core_rule",
        "reason",
        "Vietnamese translation"
      ]
    },
    "if_incorrect_answers_less_than_or_equal_to_5": {
      "include": [
        "correct option",
        "correct word",
        "meaning of relevant options",
        "relevant usage",
        "why correct answer fits",
        "why alternatives are less appropriate",
        "Vietnamese translation"
      ]
    }
  }
}
