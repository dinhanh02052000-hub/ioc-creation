OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Tuỳ chọn: model mạnh hơn dành riêng cho pipeline xác định/kiểm tra đáp án MCQ
# (server/main.py: _determine_and_verify_answers). Bỏ trống = dùng lại OPENAI_MODEL.
OPENAI_ANSWER_MODEL=
GOOGLE_CLIENT_ID=560912613294-ohckrbqk8hk8po63dd2hem52efo39emc.apps.googleusercontent.com

# Database Postgres (VD Neon.tech, free tier) - PHẢI có, không còn SQLite nữa
# (SQLite bị xoá mỗi lần server khởi động lại trên hosting free tier).
DATABASE_URL=

# Key Shop - thanh toán thật qua VietQR + webhook SePay (xem server/main.py:
# /api/keys/create-payment, /api/webhooks/sepay). SEPAY_API_KEY để trống =
# webhook luôn từ chối (an toàn), điền vào sau khi đăng ký sepay.vn.
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_BIN=
VIETQR_TEMPLATE=compact2
SEPAY_API_KEY=

# ---- Định tuyến model theo khâu (xem server/ai_router.py) ----
# Chỉ cần thêm MỘT khóa mới: ANTHROPIC_API_KEY (dùng chung cho Sonnet và Opus). OPENAI_API_KEY có sẵn dùng cho cả Sol và Luna.
# Model bắt đầu bằng "claude" -> gọi Anthropic; còn lại -> OpenAI. Bỏ trống một biến AI_MODEL_* = khâu đó dùng OPENAI_MODEL như cũ.
ANTHROPIC_API_KEY=

# Effort cho MỌI khâu (low|medium|high|xhigh|max). Muốn một khâu khác thì bỏ dấu # ở dòng AI_EFFORT_<KHÂU> bên dưới, nó thắng giá trị này.
AI_EFFORT_DEFAULT=low

# Giới hạn token đầu ra mỗi lần gọi Claude (mặc định 16000).
# ANTHROPIC_MAX_TOKENS=16000

# 20 câu Recognition (và 10 câu trắc nghiệm ôn tập): Sonnet sinh, Sol kiểm.
AI_MODEL_RECOGNITION_GEN=claude-sonnet-5-5
AI_MODEL_RECOGNITION_JUDGE=gpt-6.2-sol
# Lượt thẩm định thứ hai (AI 2, đảo thứ tự phương án): model KHÁC AI 1 để hai AI độc lập thật.
AI_MODEL_RECOGNITION_JUDGE_2=claude-sonnet-5-5
AI_MODEL_RECOGNITION_DIVERSITY=gpt-6.2-sol

# Đề Distinction/Application (cả đề viết trong phần ôn tập): Sonnet sinh.
AI_MODEL_OPEN_GEN=claude-sonnet-5-5

# Chấm tự luận: lượt 1 (kèm đáp án mẫu) Sonnet, lượt 2 Sol, lượt 3 Opus (chỉ khi hai lượt lệch > 0,75).
AI_MODEL_GRADE_1=claude-sonnet-5-5
AI_MODEL_GRADE_2=gpt-6.2-sol
AI_MODEL_GRADE_3=claude-opus-5-5

# Present knowledge (bài học), thẻ ôn trọng tâm, chấm câu tự thử trong thẻ: Luna.
AI_MODEL_LESSON=gpt-6-luna
AI_MODEL_CARDS=gpt-6-luna
AI_MODEL_TRY_ASSESS=gpt-6-luna

# Lời giải sau khi nộp trắc nghiệm: Sonnet. Xét báo cáo (trắc nghiệm + tự luận): Sol. Đề xuất quy tắc học: Sonnet.
AI_MODEL_EXPLANATION=claude-sonnet-5-5
AI_MODEL_REPORT=gpt-6.2-sol
AI_MODEL_RULES=claude-sonnet-5-5

# Effort riêng từng khâu (tuỳ chọn, bỏ # để dùng). Ví dụ đổi một khâu lên medium cho kỹ hơn (đang để mọi khâu là low):
# AI_EFFORT_RECOGNITION_GEN=low
# AI_EFFORT_RECOGNITION_JUDGE=low
# AI_EFFORT_RECOGNITION_DIVERSITY=low
# AI_EFFORT_OPEN_GEN=low
# AI_EFFORT_GRADE_1=low
# AI_EFFORT_GRADE_2=low
# AI_EFFORT_GRADE_3=low
# AI_EFFORT_LESSON=low
# AI_EFFORT_CARDS=low
# AI_EFFORT_TRY_ASSESS=low
# AI_EFFORT_EXPLANATION=low
# AI_EFFORT_REPORT=low
# AI_EFFORT_RULES=low

# ---- Demo Lab (CHỈ chạy local; xem server/lab.py). Bỏ trống LAB_ENABLED hoặc đặt 0 = tắt hoàn toàn. ----
# Cần: pip install -r server/requirements-lab.txt (python-docx để xuất báo cáo Word). Mở http://localhost:8010/lab.html sau khi đăng nhập.
LAB_ENABLED=0
LAB_ALLOWED_EMAILS=anhd91167@gmail.com,dinhanh02052000@gmail.com
